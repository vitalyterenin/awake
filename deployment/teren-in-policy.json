{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PreservePublicObjectRead",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::teren.in/*"
    },
    {
      "Sid": "PreserveExistingAccess",
      "Effect": "Allow",
      "NotPrincipal": {
        "CanonicalUser": [
          "ajeu7547nhflc1cc4qfo",
          "AWAKE_PUBLISHER_SERVICE_ACCOUNT_ID"
        ]
      },
      "Action": "*",
      "Resource": [
        "arn:aws:s3:::teren.in",
        "arn:aws:s3:::teren.in/*"
      ]
    },
    {
      "Sid": "DisplayDialsTwoReleaseObjectsOnly",
      "Effect": "Allow",
      "Principal": {
        "CanonicalUser": "ajeu7547nhflc1cc4qfo"
      },
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::teren.in/apps/DisplayDials.dmg",
        "arn:aws:s3:::teren.in/apps/feeds/display-dials.xml"
      ]
    },
    {
      "Sid": "AwakeTwoReleaseObjectsOnly",
      "Effect": "Allow",
      "Principal": {
        "CanonicalUser": "AWAKE_PUBLISHER_SERVICE_ACCOUNT_ID"
      },
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::teren.in/apps/Awake.dmg",
        "arn:aws:s3:::teren.in/apps/feeds/awake.xml"
      ]
    }
  ]
}
